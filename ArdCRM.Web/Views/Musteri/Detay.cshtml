@model ArdCRM.Core.Entities.Musteri
@using ArdCRM.Core.Enums
@{
    ViewData["Title"] = Model.FirmaAdi;
    var (badgeClass, tipLabel) = Model.Tip switch
    {
        MusteriTipi.Aktif   => ("success", "Aktif"),
        MusteriTipi.Pasif   => ("secondary", "Pasif"),
        MusteriTipi.VIP     => ("warning text-dark", "VIP"),
        _                   => ("info text-dark", "Potansiyel")
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="mb-0">@Model.FirmaAdi</h4>
        <span class="text-muted small">@Model.TamAd</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Duzenle" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">Düzenle</a>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">← Liste</a>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light small fw-500">İletişim Bilgileri</div>
            <div class="card-body">
                <table class="table table-sm table-borderless mb-0">
                    <tr>
                        <td class="text-muted" style="width:40%">Telefon</td>
                        <td>@(Model.Telefon ?? "-")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">E-posta</td>
                        <td>
                            @if (!string.IsNullOrEmpty(Model.Email))
                            {
                                <a href="mailto:@Model.Email">@Model.Email</a>
                            }
                            else { <span>-</span> }
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">Adres</td>
                        <td>@(Model.Adres ?? "-")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Şehir</td>
                        <td>@(Model.Sehir ?? "-")</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-light small fw-500">Firma Bilgileri</div>
            <div class="card-body">
                <table class="table table-sm table-borderless mb-0">
                    <tr>
                        <td class="text-muted" style="width:40%">Tip</td>
                        <td><span class="badge bg-@badgeClass">@tipLabel</span></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Vergi No</td>
                        <td>@(Model.VergiNo ?? "-")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Vergi Dairesi</td>
                        <td>@(Model.VergiDairesi ?? "-")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Kayıt Tarihi</td>
                        <td>@Model.OlusturmaTarihi.ToString("dd.MM.yyyy")</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Notlar))
    {
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-light small fw-500">Notlar</div>
                <div class="card-body">
                    <p class="mb-0">@Model.Notlar</p>
                </div>
            </div>
        </div>
    }

    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <span class="small fw-500">Teklifler</span>
                <a asp-controller="Teklif" asp-action="Ekle" asp-route-musteriId="@Model.Id"
                   class="btn btn-sm btn-outline-primary">+ Teklif Oluştur</a>
            </div>
            <div class="card-body text-muted small">
                Teklifler modülü yakında eklenecek.
            </div>
        </div>
    </div>
</div>
