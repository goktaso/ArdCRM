@model IEnumerable<ArdCRM.Core.Entities.Musteri>
@using ArdCRM.Core.Enums
@{
    ViewData["Title"] = "Müşteriler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Müşteriler</h4>
    <a asp-action="Ekle" class="btn btn-sm btn-primary">+ Yeni Müşteri</a>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <p>Henüz müşteri eklenmemiş.</p>
        <a asp-action="Ekle" class="btn btn-outline-primary btn-sm">İlk müşteriyi ekle</a>
    </div>
}
else
{
    <div class="row g-2 mb-3">
    <div class="col-md-5">
        <input type="text" id="ara" class="form-control form-control-sm" placeholder="Firma adı veya kişi ara...">
    </div>
    <div class="col-md-3">
        <select id="tipFiltre" class="form-select form-select-sm">
            <option value="">Tüm tipler</option>
            <option value="Potansiyel">Potansiyel</option>
            <option value="Aktif">Aktif</option>
            <option value="Pasif">Pasif</option>
            <option value="VIP">VIP</option>
        </select>
    </div>
    <div class="col-md-2">
        <input type="text" id="sehirFiltre" class="form-control form-control-sm" placeholder="Şehir...">
    </div>
    <div class="col-md-2">
        <button onclick="filtreTemizle()" class="btn btn-sm btn-outline-secondary w-100">Temizle</button>
    </div>
</div>
<div id="sonucSayisi" class="text-muted small mb-2"></div>
<div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Firma / Ad</th>
                    <th>Telefon</th>
                    <th>E-posta</th>
                    <th>Şehir</th>
                    <th>Tip</th>
                    <th class="text-end">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr class="musteri-satir"
                        data-firma="@m.FirmaAdi.ToLower()"
                        data-ad="@m.TamAd.ToLower()"
                        data-sehir="@(m.Sehir?.ToLower() ?? "")"
                        data-tip="@m.Tip">
                        <td>
                            <div class="fw-500">@m.FirmaAdi</div>
                            <small class="text-muted">@m.TamAd</small>
                        </td>
                        <td>@(m.Telefon ?? "-")</td>
                        <td>@(m.Email ?? "-")</td>
                        <td>@(m.Sehir ?? "-")</td>
                        <td>
                            @{
                                var (badgeClass, label) = m.Tip switch
                                {
                                    MusteriTipi.Aktif       => ("success", "Aktif"),
                                    MusteriTipi.Pasif       => ("secondary", "Pasif"),
                                    MusteriTipi.VIP         => ("warning text-dark", "VIP"),
                                    _                       => ("info text-dark", "Potansiyel")
                                };
                            }
                            <span class="badge bg-@badgeClass">@label</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Detay" asp-route-id="@m.Id" class="btn btn-outline-secondary btn-sm">Detay</a>
                            <a asp-action="Duzenle" asp-route-id="@m.Id" class="btn btn-outline-primary btn-sm">Düzenle</a>
                            <form asp-action="Sil" asp-route-id="@m.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('@m.FirmaAdi silinecek. Emin misiniz?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <small id="altSayi" class="text-muted">Toplam @Model.Count() müşteri</small>

@section Scripts {
<script>
const satirlar = document.querySelectorAll(".musteri-satir");
const toplamSayi = satirlar.length;

function filtrele() {
    const ara = document.getElementById("ara").value.toLowerCase();
    const tip = document.getElementById("tipFiltre").value;
    const sehir = document.getElementById("sehirFiltre").value.toLowerCase();
    let gorunen = 0;
    satirlar.forEach(s => {
        const araEsles = !ara || s.dataset.firma.includes(ara) || s.dataset.ad.includes(ara);
        const tipEsles = !tip || s.dataset.tip === tip;
        const sehirEsles = !sehir || s.dataset.sehir.includes(sehir);
        const goster = araEsles && tipEsles && sehirEsles;
        s.style.display = goster ? "" : "none";
        if (goster) gorunen++;
    });
    document.getElementById("sonucSayisi").textContent =
        gorunen < toplamSayi ? gorunen + " / " + toplamSayi + " müşteri gösteriliyor" : "";
    document.getElementById("altSayi").textContent = "Toplam " + toplamSayi + " müşteri";
}

function filtreTemizle() {
    document.getElementById("ara").value = "";
    document.getElementById("tipFiltre").value = "";
    document.getElementById("sehirFiltre").value = "";
    filtrele();
}

document.getElementById("ara").addEventListener("input", filtrele);
document.getElementById("tipFiltre").addEventListener("change", filtrele);
document.getElementById("sehirFiltre").addEventListener("input", filtrele);
</script>
}
}
