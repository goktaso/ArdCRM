@model ArdCRM.Core.Entities.Musteri
@using ArdCRM.Core.Enums

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="FirmaAdi" class="form-label">Firma Adı <span class="text-danger">*</span></label>
        <input asp-for="FirmaAdi" class="form-control" placeholder="Şirket adı" />
        <span asp-validation-for="FirmaAdi" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Ad" class="form-label">Ad <span class="text-danger">*</span></label>
        <input asp-for="Ad" class="form-control" placeholder="İsim" />
        <span asp-validation-for="Ad" class="text-danger small"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Soyad" class="form-label">Soyad</label>
        <input asp-for="Soyad" class="form-control" placeholder="Soyisim" />
    </div>
    <div class="col-md-4">
        <label asp-for="Telefon" class="form-label">Telefon</label>
        <input asp-for="Telefon" class="form-control" placeholder="0532 000 00 00" />
    </div>
    <div class="col-md-4">
        <label asp-for="Email" class="form-label">E-posta</label>
        <input asp-for="Email" class="form-control" type="email" placeholder="ornek@firma.com" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Tip" class="form-label">Müşteri Tipi</label>
        <select asp-for="Tip" class="form-select"
                asp-items="Html.GetEnumSelectList<MusteriTipi>()"></select>
    </div>
    <div class="col-md-6">
        <label asp-for="VergiNo" class="form-label">Vergi No</label>
        <input asp-for="VergiNo" class="form-control" placeholder="1234567890" />
    </div>
    <div class="col-md-6">
        <label asp-for="VergiDairesi" class="form-label">Vergi Dairesi</label>
        <input asp-for="VergiDairesi" class="form-control" placeholder="Alsancak V.D." />
    </div>
    <div class="col-md-8">
        <label asp-for="Adres" class="form-label">Adres</label>
        <input asp-for="Adres" class="form-control" placeholder="Sokak, mahalle..." />
    </div>
    <div class="col-md-4">
        <label asp-for="Sehir" class="form-label">Şehir</label>
        <input asp-for="Sehir" class="form-control" placeholder="İzmir" />
    </div>
    <div class="col-12">
        <label asp-for="Notlar" class="form-label">Notlar</label>
        <textarea asp-for="Notlar" class="form-control" rows="3" placeholder="Müşteri hakkında notlar..."></textarea>
    </div>
</div>
