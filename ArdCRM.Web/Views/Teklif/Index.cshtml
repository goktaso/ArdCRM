@model IEnumerable<ArdCRM.Core.Entities.Teklif>
@using ArdCRM.Core.Enums
@{
    ViewData["Title"] = "Teklifler";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">Teklifler</h4>
    <a asp-action="Ekle" class="btn btn-sm btn-primary">+ Yeni Teklif</a>
</div>

@if (!Model.Any())
{
    <div class="text-center text-muted py-5">
        <p>Henüz teklif oluşturulmamış.</p>
        <a asp-action="Ekle" class="btn btn-outline-primary btn-sm">İlk teklifi oluştur</a>
    </div>
}
else
{
    <div class="row g-2 mb-3">
        <div class="col-md-5">
            <input type="text" id="ara" class="form-control form-control-sm" placeholder="Teklif no, başlık ara...">
        </div>
        <div class="col-md-3">
            <select id="durumFiltre" class="form-select form-select-sm">
                <option value="">Tüm durumlar</option>
                <option value="Taslak">Taslak</option>
                <option value="Gonderildi">Gönderildi</option>
                <option value="Gorusuluyor">Görüşülüyor</option>
                <option value="Onaylandi">Onaylandı</option>
                <option value="Reddedildi">Reddedildi</option>
                <option value="Iptal">İptal</option>
            </select>
        </div>
        <div class="col-md-2">
            <button onclick="filtreTemizle()" class="btn btn-sm btn-outline-secondary w-100">Temizle</button>
        </div>
    </div>
    <div id="sonucSayisi" class="text-muted small mb-2"></div>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Teklif No</th>
                    <th>Müşteri</th>
                    <th>Başlık</th>
                    <th class="text-end">Tutar</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                    <th class="text-end">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr class="teklif-satir" data-no="@t.TeklifNo.ToLower()" data-baslik="@t.Baslik.ToLower()" data-durum="@t.Durum.ToString()">
                        <td><span class="font-monospace small">@t.TeklifNo</span></td>
                        <td>@(t.Musteri?.FirmaAdi ?? "-")</td>
                        <td>@t.Baslik</td>
                        <td class="text-end">@t.Tutar.ToString("N2") @t.Para</td>
                        <td>@t.TeklifTarihi.ToString("dd.MM.yyyy")</td>
                        <td>
                            @{
                                var (badgeClass, durumLabel) = t.Durum switch
                                {
                                    TeklifDurumu.Onaylandi   => ("success",          "Onaylandı"),
                                    TeklifDurumu.Reddedildi  => ("danger",           "Reddedildi"),
                                    TeklifDurumu.Gonderildi  => ("primary",          "Gönderildi"),
                                    TeklifDurumu.Gorusuluyor => ("info text-dark",   "Görüşülüyor"),
                                    TeklifDurumu.Iptal       => ("secondary",        "İptal"),
                                    _                        => ("light text-dark",  "Taslak")
                                };
                            }
                            <span class="badge bg-@badgeClass">@durumLabel</span>
                        </td>
                        <td class="text-end">
                            <a asp-action="Detay"   asp-route-id="@t.Id" class="btn btn-outline-secondary btn-sm">Detay</a>
                            <a asp-action="Duzenle" asp-route-id="@t.Id" class="btn btn-outline-primary btn-sm">Düzenle</a>
                            <form asp-action="Sil"  asp-route-id="@t.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('@t.TeklifNo nolu teklif silinecek. Emin misiniz?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">Sil</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <small id="altSayi" class="text-muted">Toplam @Model.Count() teklif</small>

@section Scripts {
<script>
const satirlar = document.querySelectorAll(".teklif-satir");
const toplamSayi = satirlar.length;

function filtrele() {
    const ara = document.getElementById("ara").value.toLowerCase();
    const durum = document.getElementById("durumFiltre").value;
    let gorunen = 0;
    satirlar.forEach(s => {
        const araEsles = !ara || s.dataset.no.includes(ara) || s.dataset.baslik.includes(ara);
        const durumEsles = !durum || s.dataset.durum === durum;
        const goster = araEsles && durumEsles;
        s.style.display = goster ? "" : "none";
        if (goster) gorunen++;
    });
    document.getElementById("sonucSayisi").textContent =
        gorunen < toplamSayi ? gorunen + " / " + toplamSayi + " teklif gösteriliyor" : "";
}

function filtreTemizle() {
    document.getElementById("ara").value = "";
    document.getElementById("durumFiltre").value = "";
    filtrele();
}

document.getElementById("ara").addEventListener("input", filtrele);
document.getElementById("durumFiltre").addEventListener("change", filtrele);
</script>
}
}
