<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ARD CRM</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .navbar-brand { font-weight: 700; color: #e65c00 !important; }
        .nav-link.active { color: #e65c00 !important; font-weight: 500; }
        .alert-dismissible .btn-close { padding: 0.5rem; }
        .table th { background-color: #f8f9fa; font-weight: 500; font-size: 0.875rem; }
        .badge-potansiyel { background-color: #6c757d; }
        .badge-aktif      { background-color: #198754; }
        .badge-pasif      { background-color: #dc3545; }
        .badge-vip        { background-color: #e65c00; }
        footer { margin-top: 3rem; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <img src="~/img/ard_logo.png" alt="ARD Logo" style="height:36px; width:auto;" />
                    <span style="font-size:13px; line-height:1.2;">
                        <strong style="font-size:16px;">ARD CRM</strong><br/>
                        <span class="text-muted fw-normal" style="font-size:11px;">ARD Sistem Danismanlik</span>
                    </span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Musteri" asp-action="Index">Müşteriler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Teklif" asp-action="Index">Teklifler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Erp" asp-action="Index">ERP Senkron</a>
                        </li>
                    </ul>
                    <span class="navbar-text text-muted small">
                        ARD Sistem Danışmanlık
                    </span>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (TempData["Basari"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-1"></i> @TempData["Basari"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Hata"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-1"></i> @TempData["Hata"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top py-3 text-muted small">
        <div class="container">
            &copy; @DateTime.Now.Year — ARD Sistem Danışmanlık
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
